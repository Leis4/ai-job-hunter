# AI Job Hunter — example environment.
# Copy to .env. All keys are optional: the app works offline without them.
# Never commit the real .env.

# Optional OpenAI-compatible provider (local Qwen, Ollama, AITUNNEL, etc.)
JOB_HUNTER_API_BASE=https://api.example.com/v1
JOB_HUNTER_API_KEY=
JOB_HUNTER_MODEL=example-model

# Optional alternate provider
AITUNNEL_API_BASE=https://api.example.com/v1
AITUNNEL_API_KEY=

# Optional Telegram notifications
JOB_HUNTER_TELEGRAM_TOKEN=
JOB_HUNTER_TELEGRAM_CHAT=

# Optional path overrides
# JOB_HUNTER_CONFIG_DIR=./config
# JOB_HUNTER_DATA_DIR=./data
